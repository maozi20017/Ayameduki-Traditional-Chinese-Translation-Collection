  <!-- EN: {0} を使用して能力を獲得する -->
  <Aya_CI_Skill_Gain_c.comps.CompUsable.useLabel>使用{0}獲得能力</Aya_CI_Skill_Gain_c.comps.CompUsable.useLabel>
  <!-- EN: コンフラグレイション -->
  <Aya_CI_Skill_Gain_c.comps.Aya_CI_CompUseEffect_SkillGain.skillCompProperties.commandLabel>烈焰爆炎</Aya_CI_Skill_Gain_c.comps.Aya_CI_CompUseEffect_SkillGain.skillCompProperties.commandLabel>
  <!-- EN: 指定したマスに火炎爆発を発生させる。 -->
